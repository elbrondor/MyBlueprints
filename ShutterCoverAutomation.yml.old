blueprint:
  name: Rollo Steuerung – Sonnenaufgang / Sonnenuntergang
  description: "Steuerung eines Rollos abhängig von Sonnenaufgang und Sonnenuntergang.
    Öffnen kann auf Werktage sowie Wochenenden/Feiertage unterschiedlich
    verzögert werden. Zusätzlich kann ein Tür-/Fenstersensor als
    Aussperrschutz verwendet werden."
  domain: automation
  author: Jonny.S@gmx.de

  input:

    cover_entity:
      name: Rollo
      description: Die Cover-Entität des zu steuernden Rollos.
      selector:
        entity:
          domain: cover

    # ---------------------------------------------------------
    # ÖFFNEN
    # ---------------------------------------------------------

    open_at_sunrise:
      name: Bei Sonnenaufgang öffnen
      description: Das Rollo wird abhängig vom Sonnenaufgang geöffnet.
      default: true
      selector:
        boolean:

    sunrise_offset:
      name: Offset zum Sonnenaufgang
      description: >
        Positive Werte öffnen nach Sonnenaufgang, negative Werte vor
        Sonnenaufgang.
      default: "00:00:00"
      selector:
        duration:
          enable_day: false
          enable_millisecond: false

    earliest_weekday:
      name: Früheste Öffnungszeit – Werktage
      description: >
        Das Rollo wird an Werktagen niemals vor dieser Uhrzeit geöffnet.
      default: "07:00:00"
      selector:
        time:

    earliest_weekend:
      name: Früheste Öffnungszeit – Wochenende / Feiertage
      description: >
        Das Rollo wird am Wochenende bzw. an Feiertagen niemals vor
        dieser Uhrzeit geöffnet.
      default: "08:00:00"
      selector:
        time:

    workday_sensor:
      name: Arbeitstag-Sensor
      description: >
        Optionaler Binary Sensor der Workday-Integration.
        ON = Arbeitstag, OFF = Wochenende oder Feiertag.
        Wenn kein Sensor angegeben wird, wird nur zwischen Montag-Freitag
        und Samstag-Sonntag unterschieden.
      default: ""
      selector:
        entity:
          domain: binary_sensor

    # ---------------------------------------------------------
    # SCHLIESSEN
    # ---------------------------------------------------------

    close_at_sunset:
      name: Bei Sonnenuntergang schließen
      description: Das Rollo wird abhängig vom Sonnenuntergang geschlossen.
      default: true
      selector:
        boolean:

    sunset_offset:
      name: Offset zum Sonnenuntergang
      description: >
        Positive Werte schließen nach Sonnenuntergang, negative Werte
        vor Sonnenuntergang.
      default: "00:00:00"
      selector:
        duration:
          enable_day: false
          enable_millisecond: false

    # ---------------------------------------------------------
    # AUSSPERRSCHUTZ
    # ---------------------------------------------------------

    door_sensor:
      name: Tür-/Fenstersensor
      description: >
        Optionaler Binary Sensor für eine Tür oder ein Fenster.
        Wenn der Sensor ON ist, wird das Rollo nicht automatisch geschlossen.
        Geeignet für Sensoren mit Auf/Zu bzw. Auf/Zu/Gekippt-Erkennung.
      default: ""
      selector:
        entity:
          domain: binary_sensor

    prevent_close_when_open:
      name: Schließen bei geöffneter Tür verhindern
      description: >
        Wenn aktiviert, wird das Rollo nicht geschlossen, solange der
        angegebene Tür-/Fenstersensor geöffnet ist.
      default: true
      selector:
        boolean:


mode: restart

variables:
  cover_entity: !input cover_entity
  door_sensor: !input door_sensor
  prevent_close_when_open: !input prevent_close_when_open
  workday_sensor: !input workday_sensor

  open_at_sunrise: !input open_at_sunrise
  close_at_sunset: !input close_at_sunset

  earliest_weekday: !input earliest_weekday
  earliest_weekend: !input earliest_weekend

# =============================================================
# TRIGGER
# =============================================================

trigger:

  # Sonnenaufgang
  - platform: sun
    event: sunrise
    offset: !input sunrise_offset
    id: sunrise

  # Früheste Öffnungszeit Werktag
  - platform: time
    at: !input earliest_weekday
    id: weekday_time

  # Früheste Öffnungszeit Wochenende / Feiertag
  - platform: time
    at: !input earliest_weekend
    id: weekend_time

  # Sonnenuntergang
  - platform: sun
    event: sunset
    offset: !input sunset_offset
    id: sunset


# =============================================================
# ACTIONS
# =============================================================

action:

  - choose:

      # -------------------------------------------------------
      # ÖFFNEN – SONNENAUFGANG
      # -------------------------------------------------------

      - conditions:
          - condition: trigger
            id: sunrise

          - condition: template
            value_template: >
              {{ open_at_sunrise }}

          # Öffnung erst ab der für den Tag gültigen Uhrzeit
          - condition: template
            value_template: >
              {% if workday_sensor != '' %}
                {% set is_workday = is_state(workday_sensor, 'on') %}
              {% else %}
                {% set is_workday = now().weekday() < 5 %}
              {% endif %}

              {% set earliest =
                earliest_weekday if is_workday else earliest_weekend
              %}

              {{ now().strftime('%H:%M:%S') >= earliest }}

        sequence:
          - service: cover.open_cover
            target:
              entity_id: !input cover_entity


      # -------------------------------------------------------
      # ÖFFNEN – FRÜHESTE ZEIT WERKTAG
      # -------------------------------------------------------

      - conditions:
          - condition: trigger
            id: weekday_time

          - condition: template
            value_template: >
              {{ open_at_sunrise }}

          # Nur an Werktagen
          - condition: template
            value_template: >
              {% if workday_sensor != '' %}
                {{ is_state(workday_sensor, 'on') }}
              {% else %}
                {{ now().weekday() < 5 }}
              {% endif %}

          # Prüfen, ob Sonnenaufgang bereits erreicht wurde
          - condition: sun
            after: sunrise
            after_offset: !input sunrise_offset

        sequence:
          - service: cover.open_cover
            target:
              entity_id: !input cover_entity


      # -------------------------------------------------------
      # ÖFFNEN – FRÜHESTE ZEIT WOCHENENDE / FEIERTAG
      # -------------------------------------------------------

      - conditions:
          - condition: trigger
            id: weekend_time

          - condition: template
            value_template: >
              {{ open_at_sunrise }}

          # Nur Wochenende / Feiertag
          - condition: template
            value_template: >
              {% if workday_sensor != '' %}
                {{ is_state(workday_sensor, 'off') }}
              {% else %}
                {{ now().weekday() >= 5 }}
              {% endif %}

          # Prüfen, ob Sonnenaufgang bereits erreicht wurde
          - condition: sun
            after: sunrise
            after_offset: !input sunrise_offset

        sequence:
          - service: cover.open_cover
            target:
              entity_id: !input cover_entity


      # -------------------------------------------------------
      # SCHLIESSEN – SONNENUNTERGANG
      # -------------------------------------------------------

      - conditions:
          - condition: trigger
            id: sunset

          - condition: template
            value_template: >
              {{ close_at_sunset }}

          # Aussperrschutz
          - condition: template
            value_template: >
              {% if prevent_close_when_open and door_sensor != '' %}
                {{ not is_state(door_sensor, 'on') }}
              {% else %}
                true
              {% endif %}

        sequence:
          - service: cover.close_cover
            target:
              entity_id: !input cover_entity
